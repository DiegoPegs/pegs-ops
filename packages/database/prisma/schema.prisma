generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Produto que o negócio fabrica ou revende.
/// Sem variantes, receitas, estoque, categorias ou tags nesta etapa.
model Product {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @db.VarChar(120)
  description String?
  sourceType  String?   @map("source_type") @db.VarChar(60)
  sourceUrl   String?   @map("source_url") @db.VarChar(2048)
  notes       String?
  archivedAt  DateTime? @map("archived_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([archivedAt])
  @@index([name])
  @@map("products")
}
