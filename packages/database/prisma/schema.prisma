generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Origem do modelo de um produto (MakerWorld, Printables, Cliente, Próprio…).
model Origin {
  id   String @id @default(uuid()) @db.Uuid
  name String @unique @db.VarChar(60)

  products Product[]

  @@map("origins")
}

/// Produto que o negócio fabrica ou revende.
/// Sem variantes, receitas, estoque, categorias ou tags nesta etapa.
model Product {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @db.VarChar(120)
  description String?
  originId    String?   @map("origin_id") @db.Uuid
  originUrl   String?   @map("origin_url") @db.VarChar(2048)
  notes       String?
  archivedAt  DateTime? @map("archived_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  origin   Origin?   @relation(fields: [originId], references: [id], onDelete: SetNull)
  variants Variant[]

  @@index([archivedAt])
  @@index([name])
  @@index([originId])
  @@map("products")
}

/// Variante: o que de fato é produzido a partir de um Produto.
/// Sem receitas, estoque, fotos, arquivos ou preços nesta etapa.
model Variant {
  id         String    @id @default(uuid()) @db.Uuid
  productId  String    @map("product_id") @db.Uuid
  sku        String?   @db.VarChar(60)
  archivedAt DateTime? @map("archived_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  product    Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  attributes VariantAttribute[]

  @@index([productId])
  @@index([archivedAt])
  @@map("variants")
}

/// Atributo livre de uma variante (Modelo = Gato, Cor = Branco).
/// Definições e opções fechadas virão com o módulo de Administração.
model VariantAttribute {
  id        String @id @default(uuid()) @db.Uuid
  variantId String @map("variant_id") @db.Uuid
  name      String @db.VarChar(60)
  value     String @db.VarChar(200)

  variant Variant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([variantId])
  @@map("variant_attributes")
}
