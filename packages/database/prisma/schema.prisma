generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Origem do modelo de um produto (MakerWorld, Printables, Cliente, Próprio…).
model Origin {
  id   String @id @default(uuid()) @db.Uuid
  name String @unique @db.VarChar(60)

  products Product[]

  @@map("origins")
}

/// Produto que o negócio fabrica ou revende.
/// Sem variantes, receitas, estoque, categorias ou tags nesta etapa.
model Product {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @db.VarChar(120)
  description String?
  originId    String?   @map("origin_id") @db.Uuid
  originUrl   String?   @map("origin_url") @db.VarChar(2048)
  notes       String?
  archivedAt  DateTime? @map("archived_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  origin   Origin?   @relation(fields: [originId], references: [id], onDelete: SetNull)
  variants Variant[]

  @@index([archivedAt])
  @@index([name])
  @@index([originId])
  @@map("products")
}

/// Variante: o que de fato é produzido a partir de um Produto.
/// Sem receitas, estoque, fotos, arquivos ou preços nesta etapa.
model Variant {
  id         String    @id @default(uuid()) @db.Uuid
  productId  String    @map("product_id") @db.Uuid
  sku        String?   @db.VarChar(60)
  archivedAt DateTime? @map("archived_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  product    Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  attributes VariantAttribute[]
  recipes    Recipe[]
  movements  StockMovement[]
  eventItems EventItem[]

  @@index([productId])
  @@index([archivedAt])
  @@map("variants")
}

/// Receita: estratégia de fabricação de uma Variante (Produção, Feira…).
/// Descreve como produzir UMA unidade; não controla produção nem estoque.
model Recipe {
  id          String    @id @default(uuid()) @db.Uuid
  variantId   String    @map("variant_id") @db.Uuid
  name        String    @db.VarChar(120)
  description String?
  archivedAt  DateTime? @map("archived_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  variant  Variant         @relation(fields: [variantId], references: [id], onDelete: Cascade)
  versions RecipeVersion[]

  @@index([variantId])
  @@index([archivedAt])
  @@map("recipes")
}

/// Versão de uma Receita: evolução da mesma estratégia de fabricação.
/// O número é sequencial por receita e nunca é renumerado ou reaproveitado.
model RecipeVersion {
  id                        String    @id @default(uuid()) @db.Uuid
  recipeId                  String    @map("recipe_id") @db.Uuid
  version                   Int
  printerName               String?   @map("printer_name") @db.VarChar(120)
  estimatedPrintTimeMinutes Int?      @map("estimated_print_time_minutes")
  estimatedFilamentGrams    Decimal?  @map("estimated_filament_grams") @db.Decimal(10, 2)
  material                  String?   @db.VarChar(120)
  estimatedCost             Decimal?  @map("estimated_cost") @db.Decimal(10, 2)
  modelSourceUrl            String?   @map("model_source_url") @db.VarChar(2048)
  notes                     String?
  isDefault                 Boolean   @default(false) @map("is_default")
  archivedAt                DateTime? @map("archived_at")
  createdAt                 DateTime  @default(now()) @map("created_at")
  updatedAt                 DateTime  @updatedAt @map("updated_at")

  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@unique([recipeId, version])
  @@index([recipeId])
  @@index([archivedAt])
  @@map("recipe_versions")
}

/// Atributo livre de uma variante (Modelo = Gato, Cor = Branco).
/// Definições e opções fechadas virão com o módulo de Administração.
model VariantAttribute {
  id        String @id @default(uuid()) @db.Uuid
  variantId String @map("variant_id") @db.Uuid
  name      String @db.VarChar(60)
  value     String @db.VarChar(200)

  variant Variant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([variantId])
  @@map("variant_attributes")
}

/// Efeito de um tipo de movimentação sobre o saldo.
enum StockMovementDirection {
  IN
  OUT
  BOTH
}

/// Tipo de movimentação de estoque. É tabela, não enum: novos tipos podem ser
/// cadastrados sem deploy, e a direção diz ao domínio como aplicar o sinal.
model StockMovementType {
  id        String                 @id @default(uuid()) @db.Uuid
  code      String                 @unique @db.VarChar(40)
  name      String                 @db.VarChar(80)
  direction StockMovementDirection

  movements StockMovement[]

  @@map("stock_movement_types")
}

/// Movimentação de estoque de uma Variante.
/// O saldo nunca é armazenado: é a soma das movimentações (D-011).
model StockMovement {
  id             String   @id @default(uuid()) @db.Uuid
  variantId      String   @map("variant_id") @db.Uuid
  movementTypeId String   @map("movement_type_id") @db.Uuid
  quantity       Int
  unitPrice      Decimal? @map("unit_price") @db.Decimal(10, 2)
  notes          String?
  createdAt      DateTime @default(now()) @map("created_at")

  variant      Variant           @relation(fields: [variantId], references: [id], onDelete: Cascade)
  movementType StockMovementType @relation(fields: [movementTypeId], references: [id])

  @@index([variantId, createdAt])
  @@index([movementTypeId])
  @@map("stock_movements")
}

/// Estado do evento. A mudança é manual nesta etapa.
enum EventStatus {
  PLANNED
  DONE
  CANCELLED
}

/// Evento: feira, exposição ou entrega para a qual se planeja produção.
model Event {
  id         String      @id @default(uuid()) @db.Uuid
  name       String      @db.VarChar(120)
  eventDate  DateTime    @map("event_date")
  status     EventStatus @default(PLANNED)
  notes      String?
  archivedAt DateTime?   @map("archived_at")
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")

  items EventItem[]

  @@index([eventDate])
  @@index([archivedAt])
  @@map("events")
}

/// Item planejado do evento: guarda apenas a Meta.
/// Estoque, produção, tempo, filamento e custo são sempre calculados (D-014).
model EventItem {
  id             String @id @default(uuid()) @db.Uuid
  eventId        String @map("event_id") @db.Uuid
  variantId      String @map("variant_id") @db.Uuid
  targetQuantity Int    @map("target_quantity")

  event   Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  variant Variant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([eventId, variantId])
  @@index([eventId])
  @@index([variantId])
  @@map("event_items")
}
